apim-referral-policy.xml
<!--
  Attach this policy to the APIM API that proxies /api/referrals.
  The named value easyfile-referral-edge-shared-secret must be a secret and must
  exactly match the Function App's EASYFILE_EDGE_SHARED_SECRET setting.
-->
<policies>
  <inbound>
    <base />
    <set-header name="X-EasyFile-Edge-Key" exists-action="override">
      <value>{{easyfile-referral-edge-shared-secret}}</value>
    </set-header>
    <set-variable name="easyfileAccountRateKey" value="@{
      if (!context.Request.Method.Equals(&quot;POST&quot;, StringComparison.OrdinalIgnoreCase)) return &quot;anonymous&quot;;
      if (context.Request.Body == null) return &quot;anonymous&quot;;
      string email = string.Empty;
      try {
        var body = Newtonsoft.Json.Linq.JObject.Parse(context.Request.Body.As&lt;string&gt;(preserveContent: true) ?? string.Empty);
        email = ((string)body?[&quot;email&quot;] ?? string.Empty).Trim().ToLowerInvariant();
      } catch { return &quot;anonymous&quot;; }
      using (var sha = System.Security.Cryptography.SHA256.Create()) {
        return Convert.ToBase64String(sha.ComputeHash(System.Text.Encoding.UTF8.GetBytes(email)));
      }
    }" />
    <set-variable name="easyfileDeviceRiskKey" value="@(context.Request.Headers.GetValueOrDefault(&quot;X-EasyFile-Device-Risk&quot;, &quot;unknown&quot;))" />

    <!-- Coarse IP protection handles volumetric abuse before the Function. -->
    <rate-limit-by-key calls="120" renewal-period="60" counter-key="@(context.Request.IpAddress)" />

    <!-- Account and device-risk controls are secondary signals, never identity. -->
    <rate-limit-by-key calls="60" renewal-period="60" counter-key="@((string)context.Variables[&quot;easyfileAccountRateKey&quot;])" />
    <rate-limit-by-key calls="90" renewal-period="60" counter-key="@((string)context.Variables[&quot;easyfileDeviceRiskKey&quot;])" />

    <choose>
      <when condition="@(context.Request.Url.Path.EndsWith(&quot;/verification-request&quot;, StringComparison.OrdinalIgnoreCase))">
        <rate-limit-by-key calls="5" renewal-period="300" counter-key="@((string)context.Variables[&quot;easyfileAccountRateKey&quot;])" />
      </when>
      <when condition="@(context.Request.Url.Path.EndsWith(&quot;/invite&quot;, StringComparison.OrdinalIgnoreCase))">
        <rate-limit-by-key calls="15" renewal-period="300" counter-key="@((string)context.Variables[&quot;easyfileAccountRateKey&quot;])" />
      </when>
    </choose>
  </inbound>
  <backend><base /></backend>
  <outbound><base /></outbound>
  <on-error><base /></on-error>
</policies>

